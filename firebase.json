{
  "hosting": {
    "public": "web/public",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/api/import", "function": { "functionId": "importAd", "region": "europe-west1" } },
      { "source": "/api/pt-prices", "function": { "functionId": "ptPrices", "region": "europe-west1" } }
    ],
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ] }
    ]
  },
  "functions": [
    { "source": "functions", "codebase": "default", "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "test", "*.log"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"] }
  ],
  "emulators": { "hosting": { "port": 5000 }, "functions": { "port": 5001 }, "ui": { "enabled": false } }
}
